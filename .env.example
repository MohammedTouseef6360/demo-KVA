# Gnani Voice AI (BolBharat) — required for STT (Prisma) and TTS (Timbre)
GNANI_API_KEY=

# LLM for NLU reasoning (Evon stand-in). Use Gemini by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: point at a hosted Gnani Evon endpoint instead of Gemini
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=evon-v3.3

# Optional overrides
GNANI_BASE=https://api.vachana.ai
PORT=3000